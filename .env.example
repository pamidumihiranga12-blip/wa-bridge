# ============================================
# Baileys Bridge - Environment Config
# Railway.app හි Environment Variables ලෙස set කරන්න
# ============================================

# ================================================
# PHP BACKEND URL (CodFlow OMS hosting domain)
# ================================================
PHP_BACKEND_URL=https://codflow.lk

# Shared secret - PHP සහ Bridge verify කරගන්න
BRIDGE_SECRET=smartzone_baileys_secret_2026

# ================================================
# SERVER SETTINGS
# ================================================
PORT=3000

# ================================================
# SESSION DATA (Railway.app persistent volume path)
# ================================================
SESSION_DIR=./sessions


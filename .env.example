# ============================================
# Baileys Bridge - Environment Config
# Railway.app හි Environment Variables ලෙස set කරන්න
# ============================================

# ================================================
# PHP BACKEND URL (ඔබේ cPanel hosting domain)
# ================================================
PHP_BACKEND_URL=https://yourdomain.com

# Shared secret - PHP සහ Bridge verify කරගන්න
# Random string ගන්න: openssl rand -hex 32
BRIDGE_SECRET=change_this_to_random_secret_key

# ================================================
# SERVER SETTINGS
# ================================================
PORT=3000

# ================================================
# SESSION DATA (Railway.app persistent volume path)
# ================================================
SESSION_DIR=./sessions

